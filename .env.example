# ── Diwali Bazaar API ─────────────────────────────────────────────
# Never commit this file. Copy .env.example for a fresh setup.

APP_ENV=development
LOG_LEVEL=INFO

# Local SQLite file. In production use Postgres, e.g.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
DATABASE_URL=sqlite+aiosqlite:///./diwali.db

# The React app (Vite dev server locally, your Vercel URL in production)
FRONTEND_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Public https URL of this API once deployed — enables Cashfree webhooks. Leave empty locally.
BACKEND_PUBLIC_URL=

# Cashfree — Dashboard → Developers → API Keys. sandbox = test payments, production = real money.
CASHFREE_APP_ID=your_app_id
CASHFREE_SECRET_KEY=your_secret_key
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# Shagun in whole rupees: SHAGUN_AMOUNT is the minimum (and default), senders may give more up to the max.
SHAGUN_AMOUNT=51
SHAGUN_MAX_AMOUNT=10000
SHAGUN_PRESETS=51,101,251,501,1100
ORDER_PREFIX=diwali
ORDER_EXPIRY_MINUTES=30

# Receipt + PDF invoice emails via Resend (https://resend.com). Leave the key empty to only log emails.
# EMAIL_FROM must use a domain verified in your Resend account.
RESEND_API_KEY=your_resend_api_key
EMAIL_FROM=Diwali Bazaar <receipts@your-verified-domain.com>
EMAIL_REPLY_TO=harshmankotia01@gmail.com
INVOICE_PREFIX=DB
